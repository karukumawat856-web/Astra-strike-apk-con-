{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "nameLower": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "online": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "friendRequests": {
      "$to": {
        "$from": {
          ".read": "auth != null && (auth.uid == $to || auth.uid == $from)",
          ".write": "auth != null && (auth.uid == $to || auth.uid == $from)"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$friend": {
          ".write": "auth != null && (auth.uid == $uid || auth.uid == $friend)"
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}